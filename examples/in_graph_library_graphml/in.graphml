<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/graphml">
  <key id="vcolor" for="node" attr.name="color" attr.type="string"><default>0</default></key>
  <graph id="G" edgedefault="undirected">
    <node id="n0"><data key="vcolor">yellow</data></node>
    <node id="n1"><data key="vcolor">red</data></node>
    <node id="n2"><data key="vcolor">green</data></node>
    <node id="n3"><data key="vcolor">blue</data></node>
    <node id="n4"><data key="vcolor">red</data></node>
    <edge source="n0" target="n1"/>
    <edge source="n0" target="n2"/>
    <edge source="n0" target="n3"/>
    <edge source="n1" target="n4"/>
  </graph>
</graphml>
